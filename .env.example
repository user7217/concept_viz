# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which backend the pipeline uses by default.
#   gemini       free tier, for bulk work: identity resolution, concept
#                extraction, tagging
#   claude_code  headless `claude -p` on a Claude subscription, for derivation
#                extraction only
ATLAS_PROVIDER=gemini

# From Google AI Studio (https://aistudio.google.com/apikey). Free tier.
GEMINI_API_KEY=

# Bounded judgment with short JSON output, so the Flash tier is the right band.
# Fallbacks if free-tier limits bite: gemini-3.5-flash (high-throughput), then
# gemini-3.5-flash-lite for pure tagging passes. Check your own limits at
# https://aistudio.google.com/rate-limit -- they are per-account, not published.
GEMINI_MODEL=gemini-3.6-flash

# Optional: pin the model headless Claude Code uses.
CLAUDE_MODEL=
