# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which backend the pipeline uses by default.
#   gemini       free tier, for bulk work: identity resolution, concept
#                extraction, tagging
#   claude_code  headless `claude -p` on a Claude subscription, for derivation
#                extraction only
ATLAS_PROVIDER=gemini

# From Google AI Studio (https://aistudio.google.com/apikey). Free tier.
GEMINI_API_KEY=

# Verify the current model name before relying on this default -- they move.
GEMINI_MODEL=gemini-2.5-flash

# Optional: pin the model headless Claude Code uses.
CLAUDE_MODEL=
